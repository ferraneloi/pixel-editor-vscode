{
  "name": "pixel-editor",
  "displayName": "Pixel Editor",
  "description": "Full-featured pixel art editor for ICO, CUR, GIF, PNG, WebP files — draw, animate, and edit pixel by pixel inside VS Code.",
  "version": "2.0.1",
  "publisher": "FerranEloi",
  "author": { "name": "Ferran Eloi" },
  "icon": "icon.png",
  "license": "MIT",
  "homepage": "https://github.com/ferraneloi/pixel-editor-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/ferraneloi/pixel-editor-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/ferraneloi/pixel-editor-vscode/issues"
  },
  "keywords": [
    "ico", "cur", "gif", "png", "webp",
    "pixel", "editor", "animation", "icon", "cursor"
  ],
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "pixelEditor.icoFile",
        "displayName": "Pixel Editor",
        "selector": [
          { "filenamePattern": "*.ico" },
          { "filenamePattern": "*.cur" },
          { "filenamePattern": "*.gif" },
          { "filenamePattern": "*.png" },
          { "filenamePattern": "*.webp" }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      { "command": "pixelEditor.newFile", "title": "Pixel Editor: New File", "icon": "$(add)" }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "package": "npm run compile && npx @vscode/vsce package --no-dependencies",
    "publish": "npm run compile && npx @vscode/vsce publish --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.3.0"
  }
}

